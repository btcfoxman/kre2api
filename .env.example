KRE2API_PORT=8800
TZ=Asia/Taipei
KR_API_KEY=replace-with-long-random-api-key
KR_ADMIN_TOKEN=replace-with-long-random-admin-token
# Optional stable encryption secret for imported passwords; keep unchanged after first import.
# KR_CREDENTIAL_KEY=replace-with-another-long-random-secret
KR_SYNC_TOKEN=replace-with-long-random-sync-token
KR_DATA_DIR=/app/data
KR_DATABASE_PATH=/app/data/kre2api.db
KR_TASK_WORKERS=4
KR_POLL_INTERVAL_SECONDS=10
KR_TASK_TIMEOUT_SECONDS=3600
KR_SYNC_TIMEOUT_SECONDS=900
KR_LOGIN_TIMEOUT_SECONDS=120
